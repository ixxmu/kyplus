detach("package:kyplus", unload = TRUE)
library(kyplus)
# 矩阵特征值分解测试
system.time({
# 创建一个 8000x8000 的对称矩阵
set.seed(123)  # 保证相同的随机数
A <- matrix(rnorm(8000*8000), 8000, 8000)
A <- t(A) %*% A  # 确保是对称矩阵
# 计算特征值
eigen(A)
})
devtools::document()  # 生成文档
devtools::build()    # 构建包
devtools::install()  # 安装包
